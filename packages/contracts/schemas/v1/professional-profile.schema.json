{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.helpingpeople.cloud/schemas/v1/professional-profile.schema.json",
  "title": "Professional Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "display_name", "state", "service_categories", "locale"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "slug": { "type": "string", "maxLength": 160 },
    "bio": { "type": "string", "maxLength": 4000 },
    "locale": { "type": "string", "enum": ["es", "en"] },
    "service_categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
    },
    "city": { "type": "string", "maxLength": 160 },
    "state": { "type": "string", "enum": ["draft", "pending_review", "published", "rejected", "unpublished", "suspended"] },
    "published_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
